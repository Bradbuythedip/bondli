# ═══ BONDLI v4 Environment Variables ═══

# Alchemy API Key — enables smart money wallet tracking + enhanced RPC
# Get a free key at https://www.alchemy.com/ (100M compute units/mo free)
# This auto-configures both RPC_URL and smart money polling
ALCHEMY_API_KEY=

# Or use a custom RPC endpoint (overrides Alchemy)
# RPC_URL=https://your-rpc-endpoint.com

# PumpPortal API key (REQUIRED for the radar to receive trades).
# https://pumpportal.fun -> Generate API key, then fund that key's wallet with >= 0.02 SOL.
PUMPPORTAL_API_KEY=

# Where trades come from. onchain = decode pump.fun trades from the Solana program logs
# (free, no key needed, default when no key is set). auto = PumpPortal's keyed stream,
# which is METERED (about 0.01 SOL per 10,000 events), falling back to onchain when it
# refuses or goes silent. pumpportal = PumpPortal only.
RADAR_TRADE_SOURCE=onchain

# RPC whose websocket carries the on-chain trade stream. Default: public mainnet-beta.
# Use a Helius URL if the public endpoint drops; do NOT use Alchemy here (billed per byte).
RADAR_STREAM_RPC_URL=

# Trading wallet master seed (base58)
MASTER_SEED=

# Platform settings
API_PORT=3001
API_SECRET=bondli_default

# X/Twitter API bearer token (for social signal scoring)
X_BEARER_TOKEN=

# LoRA GPU scorer (optional — start with: python src/ml/serve.py)
# BONDLI_LORA_URL=http://127.0.0.1:8420

# ═══ Bags.fm Integration ═══
# Get keys at https://dev.bags.fm
# API key — required for all Bags API calls (up to 10 keys per account)
BAGS_API_KEY=

# Partner wallet — earns revenue from volume of coins created through Bondli
BAGS_PARTNER_WALLET=

# Fee sweep interval (hours) — auto-claim accrued fees from Bags positions
# BAGS_FEE_SWEEP_HOURS=6

# Agent auth (optional — for agent wallet management)
# BAGS_AGENT_JWT=
