# ═══ Fleet launcher for Robinhood Chain — copy to launch/robinhood/.env (git-ignored) ═══

# The master wallet: funds the fleet, makes the launch and the dev buy, receives every sweep.
# A fresh key. Testnet ETH: https://faucet.testnet.chain.robinhood.com
PRIVATE_KEY=0x

# 46630 = Robinhood Chain testnet (rehearse here), 4663 = mainnet (real ETH; also needs FLEET_I_UNDERSTAND_MAINNET=1)
FLEET_CHAIN_ID=46630
# Defaults: testnet https://rpc.testnet.chain.robinhood.com/rpc, mainnet https://rpc.mainnet.chain.robinhood.com (public, rate-limited; an Alchemy URL is better)
# FLEET_RPC_URL=

# Launchpad. Mainnet defaults to the live PONS V2 factory and launch-and-buy router. Testnet has no PONS:
# `deploy-launchpad` writes the FleetTestLaunchpad address into fleet-state.json and it is picked up from there.
# FLEET_FACTORY=
# FLEET_ROUTER=
# FLEET_LAUNCH_CONFIG_ID=0

# The token (baked into the launch; mainnet PONS also bakes them into the CREATE2 address)
FLEET_TOKEN_NAME=Not a fruit fly
FLEET_TOKEN_SYMBOL=NOTAFRUITFLY
FLEET_LOGO=https://bondli.fun/fly.png
FLEET_DESCRIPTION=flybrain is a fruit fly. this is not.
FLEET_TWITTER=
FLEET_TELEGRAM=
FLEET_DISCORD=
FLEET_WEBSITE=https://bondli.fun
FLEET_FARCASTER=
FLEET_CREATOR_TAX_BPS=0
FLEET_BUYBACK_ENABLED=1

# A mined vanity address (mainnet). Left empty, the launcher reads launch/notafruitfly/pons-state.json when it
# was mined for this PRIVATE_KEY (FLEET_USE_PONS_STATE=0 disables that). The launch is refused if its simulation
# would create any token other than FLEET_EXPECTED_TOKEN.
# FLEET_SALT=            bytes32 hex, or the integer user salt the miner printed
# FLEET_EXPECTED_TOKEN=0x
# FLEET_USE_PONS_STATE=1

# The plan. Budget = launch fee + dev buy + the fleet's allocations (+ a gas buffer per wallet).
FLEET_BUDGET_ETH=0.05
# Dev buy on launch (exempt from the opening tax). Default: 10% of the budget (GAME_THEORY.md's sweet spot).
# FLEET_DEV_BUY_ETH=0.005
FLEET_DURATION_MIN=60
FLEET_SLIPPAGE_PCT=15
# APE mode: conviction 0-100 sets wallet count and sizing (Kelly); how long to hold before the exit
FLEET_RADAR_SCORE=50
FLEET_APE_HOLD_MIN=5
# Auto-rug: sell every wallet when no external trade for DROUGHT seconds (after MIN_WAIT seconds). 0 turns it off.
FLEET_AUTO_RUG=1
FLEET_AUTO_RUG_DROUGHT_SEC=45
FLEET_AUTO_RUG_MIN_WAIT_SEC=60
# Platform cut of each wallet's profit, taken at the sweep (leave empty for none)
# FLEET_PLATFORM_WALLET=0x
# FLEET_CUT_PERCENT=0

# The simulator's economics when not read from a chain (mainnet PONS values are printed by `preflight`)
# FLEET_SIM_PHANTOM_ETH=3
# FLEET_SIM_GRADUATION_ETH=6
# FLEET_SIM_LAUNCH_FEE_ETH=0.001

# Where wallet keys and run state live (chmod 600). Lose it and you lose the fleet's ETH.
# FLEET_STATE_FILE=launch/robinhood/fleet-state.json
